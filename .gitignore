# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
/docs/plans/

# Platform goldens use real fonts and differ per machine; only CI goldens are committed.
test/**/goldens/macos/
test/**/failures/

# Self-signed release certificate from `just make-signing-cert`; never commit.
signing.key
signing.crt
signing.p12
macos/Runner/Configs/Signing.xcconfig

# Release packages from tool/release.sh.
/dist/

# devenv: its state and the generated hook configuration.
.devenv*
devenv.local.nix
.pre-commit-config.yaml
